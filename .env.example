DATABASE_URL=postgresql+asyncpg://mkl:mkl@localhost:5432/mkl
APP_ENV=local
LOG_LEVEL=INFO

# ML Prediction Port (docs/adr/0006): URL of an external ML service
# implementing POST {ML_PREDICTOR_URL}/predict per src/services/ml_port.py.
# Leave unset to use the built-in StubPredictor.
ML_PREDICTOR_URL=

# SMVU replay engine (docs/adr/0005): how fast the emulated background
# telemetry stream advances through the real operational window.
REPLAY_SPEED_MULTIPLIER=360.0
REPLAY_TICK_SECONDS=5.0

# TLS proxy (docker compose): host ports. The API is served only over
# HTTPS (TLS 1.2+) on HTTPS_PORT; HTTP_PORT answers with a redirect.
HTTPS_PORT=8443
HTTP_PORT=8080
